{
    "typescript.tsdk": "node_modules\\typescript\\lib",
    "files.exclude": {
        "packages/*/src/**/*.js": true
    },
    "editor.formatOnSave": true,

    "chat.instructionsFilesLocations": {
        ".github/copilot.instructions.md": true
    },

    // VS Code Test Runner configuration
    "testing.automaticallyOpenTestResults": "openOnTestStart",
    "testing.automaticallyOpenPeekView": "failureInVisibleDocument",
    "testing.defaultGutterClickAction": "run",
    "testing.followRunningTest": true,

    // Mocha Explorer settings
    "eslint.workingDirectories": [
        "./packages/powerquery-parser",
        "./packages/powerquery-formatter",
        "./packages/powerquery-language-services"
    ],
    "mochaExplorer.cwd": "${workspaceFolder}/packages/powerquery-language-services",
    "mochaExplorer.files": ["test/**/*.test.ts"],
    "mochaExplorer.require": ["ts-node/register"],
    "mochaExplorer.env": {
        "NODE_ENV": "test"
    },
    "mochaExplorer.timeout": 60000,
    "mochaExplorer.ui": "bdd",
    "mochaExplorer.exit": true,
    "mochaExplorer.optsFile": ".mocharc.cjs"
}
