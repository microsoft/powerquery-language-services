{
    "name": "powerquery-monorepo",
    "private": true,
    "version": "0.0.0",
    "description": "Development workspace for the Power Query parser, formatter, and language services.",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "packages/powerquery-parser",
        "packages/powerquery-formatter",
        "packages/powerquery-language-services"
    ],
    "scripts": {
        "clean": "node scripts/workspace.cjs clean",
        "build": "npm run build --workspace @microsoft/powerquery-parser && npm run build --workspace @microsoft/powerquery-formatter && npm run build --workspace @microsoft/powerquery-language-services",
        "lint": "npm run lint --workspaces",
        "test": "npm run test:unit && npm run test:parser:resources && npm run test:release",
        "test:unit": "npm test --workspaces",
        "test:parser:resources": "npm run test:resources --workspace @microsoft/powerquery-parser",
        "test:release": "node --test scripts/test/release*.cjs",
        "version:set": "node scripts/release.cjs version",
        "version:patch": "node scripts/release.cjs patch",
        "validate:release": "node scripts/release.cjs validate",
        "pack:release": "node scripts/release.cjs pack"
    },
    "devDependencies": {
        "@eslint/js": "^9.35.0",
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.8",
        "@types/node": "^22.7.3",
        "@typescript-eslint/eslint-plugin": "5.8.1",
        "@typescript-eslint/parser": "5.8.1",
        "chai": "^4.5.0",
        "eslint": "8.5.0",
        "eslint-config-prettier": "8.3.0",
        "eslint-plugin-prettier": "4.0.0",
        "eslint-plugin-promise": "6.0.0",
        "eslint-plugin-security": "1.4.0",
        "mocha": "^12.0.3",
        "prettier": "2.5.1",
        "semver": "^7.7.2",
        "tar": "^7.5.1",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "webpack": "^5.105.1"
    }
}
