{
    "name": "powerquery-monorepo",
    "private": true,
    "version": "0.0.0",
    "description": "Development workspace for the Power Query parser, formatter, and language services.",
    "license": "MIT",
    "engines": {
        "node": ">=26.13.1"
    },
    "workspaces": [
        "packages/powerquery-parser",
        "packages/powerquery-formatter",
        "packages/powerquery-language-services"
    ],
    "scripts": {
        "clean": "ts-node scripts/workspace.ts clean",
        "build": "npm run build --workspace @microsoft/powerquery-parser && npm run build --workspace @microsoft/powerquery-formatter && npm run build --workspace @microsoft/powerquery-language-services",
        "lint": "npm run typecheck:scripts && npm run lint --workspaces",
        "typecheck:scripts": "tsc --project scripts/tsconfig.json",
        "test": "npm run test:unit && npm run test:parser:resources && npm run test:release",
        "test:unit": "npm test --workspaces",
        "test:parser:resources": "npm run test:resources --workspace @microsoft/powerquery-parser",
        "test:release": "cross-env TS_NODE_PROJECT=scripts/tsconfig.json node --require ts-node/register --test scripts/test/release*.ts",
        "version:set": "ts-node scripts/release.ts version",
        "version:patch": "ts-node scripts/release.ts patch",
        "validate:release": "ts-node scripts/release.ts validate",
        "pack:release": "ts-node scripts/release.ts pack"
    },
    "overrides": {
        "glob": "^14.0.3",
        "minimatch": "^11.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.8",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.7.1",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "chai": "^4.5.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-security": "^4.2.1",
        "mocha": "^12.0.3",
        "prettier": "^3.8.1",
        "semver": "^7.8.6",
        "tar": "^7.5.1",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "webpack": "^5.105.1"
    }
}
