{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "noUncheckedIndexedAccess": true,
        "outDir": "lib",
        "rootDir": "src",
        "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
    },
    "include": ["src/**/*.ts", "src/powerquery-parser/localization/templates/*.json"],
    "exclude": ["node_modules"],
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    }
}
