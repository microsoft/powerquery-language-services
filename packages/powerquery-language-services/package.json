{
    "name": "@microsoft/powerquery-language-services",
    "version": "5.0.0",
    "author": "Microsoft",
    "license": "MIT",
    "scripts": {
        "build": "tsc --project tsconfig.json",
        "clean": "node ../../scripts/workspace.cjs clean powerquery-language-services",
        "benchmark": "node --expose-gc --require ts-node/register src/benchmark/cli.ts",
        "watch": "tsc --project tsconfig.json --watch",
        "lint": "eslint src --ext ts",
        "test": "mocha --no-package --reporter ./mochaReporter.js --reporter-option output=test-results.xml"
    },
    "homepage": "https://github.com/microsoft/powerquery-language-services/tree/master/packages/powerquery-language-services#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/powerquery-language-services.git",
        "directory": "packages/powerquery-language-services"
    },
    "bugs": {
        "url": "https://github.com/microsoft/powerquery-language-services/issues"
    },
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "description": "Language services for the Power Query/M formula language.",
    "main": "lib/powerquery-language-services/index.js",
    "types": "lib/powerquery-language-services/index.d.ts",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "power query",
        "power bi"
    ],
    "files": [
        "lib/powerquery-language-services/**/*",
        "README.md",
        "LICENSE",
        "ARCHITECTURE.md"
    ],
    "devDependencies": {
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.8",
        "@types/node": "^22.7.3",
        "@typescript-eslint/eslint-plugin": "^8.43.0",
        "@typescript-eslint/parser": "^8.43.0",
        "chai": "^4.5.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.35.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-security": "^3.0.1",
        "mocha": "^12.0.3",
        "prettier": "3.6.2",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "webpack": "^5.105.1"
    },
    "dependencies": {
        "@microsoft/powerquery-formatter": "5.0.0",
        "@microsoft/powerquery-parser": "5.0.0",
        "vscode-languageserver-textdocument": "1.0.12",
        "vscode-languageserver-types": "3.17.5"
    }
}
