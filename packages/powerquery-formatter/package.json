{
    "name": "@microsoft/powerquery-formatter",
    "version": "5.0.0",
    "author": "Microsoft",
    "license": "MIT",
    "scripts": {
        "build": "node ../../scripts/build-package.cjs powerquery-formatter",
        "clean": "node ../../scripts/workspace.cjs clean powerquery-formatter",
        "benchmark": "node --expose-gc --require ts-node/register benchmark/cli.ts",
        "watch": "node ../../scripts/build-package.cjs powerquery-formatter --watch",
        "test": "mocha --no-package --reporter ./mochaReporter.js --reporter-option output=test-results.xml --spec test/**/*.ts",
        "script:recursiveDirectoryFormat": "npx ts-node scripts/recursiveDirectoryFormat.ts",
        "lint": "eslint src test benchmark scripts *.ts --ext ts"
    },
    "homepage": "https://github.com/microsoft/powerquery-language-services/tree/master/packages/powerquery-formatter#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/powerquery-language-services.git",
        "directory": "packages/powerquery-formatter"
    },
    "bugs": {
        "url": "https://github.com/microsoft/powerquery-language-services/issues"
    },
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "description": "A source code formatter for the Power Query/M formula language.",
    "main": "lib/powerquery-formatter/index.js",
    "types": "lib/powerquery-formatter/index.d.ts",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "power query",
        "power bi"
    ],
    "files": [
        "lib/powerquery-formatter/**/*",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "ARCHITECTURE.md"
    ],
    "devDependencies": {
        "@types/chai": "^4.3.0",
        "@types/mocha": "^9.0.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "5.8.1",
        "@typescript-eslint/parser": "5.8.1",
        "chai": "^4.3.4",
        "eslint": "8.5.0",
        "eslint-config-prettier": "8.3.0",
        "eslint-plugin-prettier": "5.5.7",
        "eslint-plugin-promise": "6.0.0",
        "eslint-plugin-security": "1.4.0",
        "mocha": "^12.0.3",
        "prettier": "2.5.1",
        "ts-loader": "^9.2.6",
        "ts-node": "^10.4.0",
        "tslint": "^6.1.3",
        "typescript": "^5.8.3",
        "webpack": "^5.105.1"
    },
    "dependencies": {
        "@microsoft/powerquery-parser": "5.0.0"
    }
}
