{
    "name": "@microsoft/powerquery-formatter",
    "version": "5.0.0",
    "author": "Microsoft",
    "license": "MIT",
    "scripts": {
        "build": "ts-node ../../scripts/build-package.ts powerquery-formatter",
        "clean": "ts-node ../../scripts/workspace.ts clean powerquery-formatter",
        "benchmark": "node --expose-gc --require ts-node/register benchmark/cli.ts",
        "watch": "ts-node ../../scripts/build-package.ts powerquery-formatter --watch",
        "test": "mocha --no-package",
        "script:recursiveDirectoryFormat": "npx ts-node scripts/recursiveDirectoryFormat.ts",
        "lint": "eslint src test benchmark scripts *.ts --ext ts"
    },
    "homepage": "https://github.com/microsoft/powerquery-language-services/tree/master/packages/powerquery-formatter#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/microsoft/powerquery-language-services.git",
        "directory": "packages/powerquery-formatter"
    },
    "bugs": {
        "url": "https://github.com/microsoft/powerquery-language-services/issues"
    },
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "description": "A source code formatter for the Power Query/M formula language.",
    "main": "lib/powerquery-formatter/index.js",
    "types": "lib/powerquery-formatter/index.d.ts",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "power query",
        "power bi"
    ],
    "files": [
        "lib/powerquery-formatter/**/*",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "ARCHITECTURE.md"
    ],
    "dependencies": {
        "@microsoft/powerquery-parser": "5.0.0"
    }
}
